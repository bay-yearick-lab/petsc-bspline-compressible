# Replace the Krylov iteration by a sparse direct LU factorization from
# SuperLU_DIST (built against METIS/ParMETIS) with a METIS fill-reducing
# column ordering. The factorization is computed once per KSP and reused for
# every wall-normal line in the time loop.
-ksp_type preonly
-pc_type lu
-pc_factor_mat_solver_type superlu_dist
-mat_superlu_dist_colperm METIS_AT_PLUS_A
